DATABASE_URL=postgresql://user:password@host:5432/familyflow
JWT_SECRET=замените-на-длинную-случайную-строку
CORS_ORIGIN=https://mariagrigoreva-cyber-familyflow-8dca.twc1.net
# PGSSL=disable   # раскомментируйте если БД без SSL (локально)

# ── ЮKassa (routes/billing.js, lib/yookassa.js) ─────────────────────────────
# Без этих двух переменных билинг просто не работает, а планировщик автосписаний
# (lib/scheduler.js) сам себя выключает с сообщением в лог.
# Ключи из личного кабинета ЮKassa — https://yookassa.ru/my/merchant/integration/api-keys
# Один и тот же URL API что для тестовых, что для боевых ключей — режим определяют сами ключи.
YK_SHOP_ID=
YK_SECRET_KEY=
# Цены опциональны — без них берутся дефолты 199 ⁄ 999 ₽ (см. PRICE в routes/billing.js, lib/scheduler.js)
PRICE_MONTHLY_RUB=199
PRICE_YEARLY_RUB=999
# Публичный адрес самого API — нужен для ссылки отмены автопродления в письме-напоминании (lib/scheduler.js)
API_PUBLIC_URL=https://mariagrigoreva-cyber-familyflow-api-bccc.twc1.net

# ── Шифрование бюджета семьи (lib/crypto.js) ────────────────────────────────
# Без этой переменной бюджет семьи хранится в БД в открытом виде (family_states.data).
# 32 байта в hex (64 символа). Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ВАЖНО: потеря ключа делает все сохранённые бюджеты нечитаемыми навсегда — храните
# резервную копию отдельно от сервера (например, в менеджере паролей).
# Без ключа сервер отказывается стартовать (server.js) — это осознанно, чтобы боевой
# запуск без шифрования не проскочил незамеченным. Для локальной разработки без ключа
# раскомментируйте опт-аут ниже; на проде эту переменную оставлять нельзя.
DATA_ENC_KEY=
# ALLOW_UNENCRYPTED_DATA=1

# ── Мониторинг ошибок (server.js) ───────────────────────────────────────────
# DSN своего GlitchTip, не облачного Sentry.io — 152-ФЗ требует не выводить
# данные об ошибках за пределы РФ. Без переменной мониторинг просто выключен.
SENTRY_DSN=

# ── Push-уведомления (lib/webpush.js, routes/push.js) ───────────────────────
# Сгенерировать пару: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@myfamilyflow.ru
# В какой час UTC слать еженедельные напоминания (lib/pushScheduler.js), по умолчанию 8
WEEKLY_PUSH_HOUR_UTC=8

# ── Мягкое удаление аккаунта (lib/accountPurgeScheduler.js) ─────────────────
# Сколько дней после /auth/delete-account хранить аккаунт восстановимым, прежде
# чем стереть его окончательно. По умолчанию 30.
ACCOUNT_PURGE_GRACE_DAYS=30

# ── Почта (lib/mail.js) ──────────────────────────────────────────────────────
# Приоритет: Unisender Go (HTTP API, порт 443 — не блокируется хостингами).
UNISENDER_API_KEY=
MAIL_FROM_EMAIL=no-reply@myfamilyflow.ru
MAIL_FROM_NAME=Семейный поток
# Запасной путь, если Unisender не настроен — SMTP через nodemailer (нужны открытые
# исходящие SMTP-порты у хостинга). Либо SMTP_HOST/PORT/USER/PASS, либо один SMTP_URL.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_URL=
MAIL_FROM=Семейный поток <no-reply@myfamilyflow.ru>

# ── Telegram-уведомления об отзывах (lib/telegram.js, routes/feedback.js) ───
# Без этих переменных уведомление просто не отправляется — сам отзыв всё равно
# сохраняется в БД (см. GET /admin/feedback).
# 1. Создайте бота через @BotFather, скопируйте токен.
# 2. Напишите боту любое сообщение, затем откройте
#    https://api.telegram.org/bot<TOKEN>/getUpdates — там будет ваш chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Админ-эндпоинты (routes/admin.js) ───────────────────────────────────────
# Без этой переменной GET /admin/feedback отвечает 503 admin_not_configured.
# Секрет передаётся в заголовке X-Admin-Key. Сгенерировать: openssl rand -hex 32
ADMIN_SECRET=

# ── Вход через Яндекс ID (routes/auth.js) ───────────────────────────────────
# Приложение на oauth.yandex.ru — Redirect URI должен быть ровно
# ${API_PUBLIC_URL}/auth/yandex/callback, запрошенный скоуп — только email.
# Без этих двух переменных кнопка «Войти с Яндекс ID» на фронтенде просто
# приведёт на страницу с ошибкой (not_configured).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ── AI-онбординг и AI-поддержка (lib/llm.js, routes/ai.js) ──────────────────
# Без AI_API_KEY оба эндпоинта /ai/* отвечают 503 ai_not_configured.
# Провайдер по умолчанию — OpenAI-совместимый chat/completions (AI_API_URL/
# AI_MODEL меняют URL/модель без кода). Если задан AI_FOLDER_ID — вместо
# этого зовётся Yandex Cloud Foundation Models (YandexGPT), формат другой.
AI_API_KEY=
# Только для YandexGPT: id каталога (folder) сервисного аккаунта в консоли
# Yandex Cloud — без него Foundation Models API не примет запрос.
AI_FOLDER_ID=
# AI_MODEL для YandexGPT — по умолчанию yandexgpt/latest (полная модель;
# yandexgpt-lite/latest дешевле и быстрее, но хуже держит структуру JSON).
AI_MODEL=
# Владелец: имеет доступ к AI всегда (вместе с AI_BETA_EMAILS ниже) и не
# считается в дневном лимите. С этапа 6 фронт email НЕ проверяет — он
# спрашивает GET /ai/status, поэтому синхронизировать это значение с
# REACT_APP_OWNER_EMAIL больше не нужно (та переменная осталась только для
# исключения своих тестов из целей Метрики).
AI_OWNER_EMAIL=

# ── AI: закрытая бета (lib/aiAccess.js) ─────────────────────────────────────
# ВАЖНО про все переменные этого блока: код читает их на каждый запрос и нигде
# не кеширует, поэтому менять их можно без правок кода и деплоя. Но новое
# значение видит только НОВЫЙ процесс: process.env наполняется один раз при
# старте, и правка переменной в панели хостинга работающий процесс не задевает
# (проверено). Автоматически ли платформа перезапускает приложение после
# сохранения переменных — надо проверить в самой панели; если нет, нужен
# ручной перезапуск. Проверить, что новое значение применилось, проще всего
# запросом GET /ai/status от нужного аккаунта.
#
# Глобальный рубильник. AI_ENABLED=false выключает помощника для всех, включая
# владельца, ДО обращения к YandexGPT. Пересборка фронта не нужна — он узнаёт
# о выключении из GET /ai/status.
AI_ENABLED=true
# Список email закрытой беты через запятую. AI_OWNER_EMAIL получает доступ
# автоматически и не считается в дневном лимите. Если не заданы ни он, ни
# список — доступ открыт всем залогиненным (удобно локально, на проде так
# оставлять нельзя).
AI_BETA_EMAILS=
# Дневной лимит запросов на пользователя — техническая защита беты от
# зацикливания и перерасхода, не тариф. По умолчанию 30.
AI_DAILY_LIMIT=30

# ── Временное профилирование GET /state ─────────────────────────────────────
# STATE_TIMING=1 включает в логах строку с разбивкой времени по фазам:
#   GET /state: auth: X ms | db: X ms | serialization: X ms | total: X ms | bytes: N
# auth — JWT + проверка token_version (одна выборка из users, middleware/auth.js);
# db — выборка family_members+family_states одним JOIN'ом и расшифровка data_enc;
# serialization — JSON.stringify ответа. Нужно, чтобы отличить медленную БД от
# дорогой расшифровки/сериализации большого снапшота бюджета. По умолчанию
# выключено — на проде включать точечно, на время разбора, и выключать обратно.
STATE_TIMING=0
