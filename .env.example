DATABASE_URL=postgresql://user:password@host:5432/familyflow
JWT_SECRET=замените-на-длинную-случайную-строку
CORS_ORIGIN=https://mariagrigoreva-cyber-familyflow-8dca.twc1.net
# PGSSL=disable   # раскомментируйте если БД без SSL (локально)

# ── ЮKassa (routes/billing.js, lib/yookassa.js) ─────────────────────────────
# Без этих двух переменных билинг просто не работает, а планировщик автосписаний
# (lib/scheduler.js) сам себя выключает с сообщением в лог.
# Ключи из личного кабинета ЮKassa — https://yookassa.ru/my/merchant/integration/api-keys
# Один и тот же URL API что для тестовых, что для боевых ключей — режим определяют сами ключи.
YK_SHOP_ID=
YK_SECRET_KEY=
# Цены опциональны — без них берутся дефолты 199 ⁄ 999 ₽ (см. PRICE в routes/billing.js, lib/scheduler.js)
PRICE_MONTHLY_RUB=199
PRICE_YEARLY_RUB=999
# Публичный адрес самого API — нужен для ссылки отмены автопродления в письме-напоминании (lib/scheduler.js)
API_PUBLIC_URL=https://mariagrigoreva-cyber-familyflow-api-bccc.twc1.net
